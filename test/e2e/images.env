# Runtime images used by the end-to-end suites. Override any value in the
# environment when an internal registry mirrors these images.
E2E_ALPINE_IMAGE=${E2E_ALPINE_IMAGE:-docker.io/library/alpine:3.20}
E2E_DEBIAN_IMAGE=${E2E_DEBIAN_IMAGE:-docker.io/library/debian:bookworm-slim}
E2E_FEDORA_IMAGE=${E2E_FEDORA_IMAGE:-docker.io/library/fedora:42}
E2E_ARCH_IMAGE=${E2E_ARCH_IMAGE:-docker.io/library/archlinux:base}
E2E_NODE_IMAGE=${E2E_NODE_IMAGE:-docker.io/library/node:22-alpine}
E2E_GO_IMAGE=${E2E_GO_IMAGE:-docker.io/library/golang:1.26-alpine}
E2E_MAVEN_IMAGE=${E2E_MAVEN_IMAGE:-docker.io/library/maven:3.9-eclipse-temurin-21-alpine}
E2E_RUST_IMAGE=${E2E_RUST_IMAGE:-docker.io/library/rust:1.88-alpine}
E2E_PYTHON_IMAGE=${E2E_PYTHON_IMAGE:-docker.io/library/python:3.13-alpine}
E2E_CRANE_IMAGE=${E2E_CRANE_IMAGE:-gcr.io/go-containerregistry/crane:v0.20.3}
